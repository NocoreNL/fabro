ANTHROPIC_API_KEY=
BRAVE_SEARCH_API_KEY=
DAYTONA_API_KEY=
DEEPSEEK_API_KEY=
FIREWORKS_API_KEY=
GEMINI_API_KEY=
INCEPTION_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
MODAL_KIMI_K3_BASE_URL=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
POOLSIDE_API_KEY=
ZAI_API_KEY=

SESSION_SECRET=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=

FABRO_SLACK_APP_TOKEN=
FABRO_SLACK_BOT_TOKEN=

# Public hostname for the prod docker-compose stack. Leave unset for
# localhost (Caddy will serve plain HTTP); set to a real DNS name to
# let Caddy auto-provision a Let's Encrypt certificate.
FABRO_DOMAIN=

# Canonical external web origin for deployments where TLS is terminated outside
# the Fabro container. Use this with the Tailscale Services compose file, for
# example https://fabro-testing.example.ts.net. Do not include a trailing slash.
FABRO_WEB_URL=

# ACA sandbox provider account scope. All four are required when the `aca`
# sandbox provider is enabled (server.sandbox.providers.aca.enabled = true);
# resource_group/sandbox_group are ops-provisioned out of band, never created
# by Fabro itself.
ACA_SUBSCRIPTION_ID=
ACA_RESOURCE_GROUP=
ACA_SANDBOX_GROUP=
ACA_REGION=

# Selects the Entra credential chain used to authenticate to the ACA data
# plane: `managed` uses the host's system-assigned managed identity (for when
# the Fabro server itself runs as an Azure-hosted workload, e.g. an Azure VM);
# `developer` (or leave unset) uses DeveloperToolsCredential (az login) for
# local dev. Note: unset/any other value defaults to developer-tools creds,
# which will fail on an Azure VM with no interactive `az login`.
ACA_AUTH_MODE=
